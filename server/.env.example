# Server Network & Runtime Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Database Persistence
# ResQAI uses high-performance SQLite via better-sqlite3 with WAL mode enabled
DB_FILE_PATH=./data/resqai.db

# Authentication & Session Security (JWT & Argon2id)
JWT_SECRET=6d4ad31e89ab27a426e42e8a5c43266508d72b9b813c25eda885326f14ace32a6c724c07689f518ea0b6e1411afdb2ba301890faa33954344c824dc6cf1fdc46
