# ==============================================================================
# ResQAI Disaster Management System — Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS BEFORE RUNNING IN PRODUCTION
# ==============================================================================

# Server Network & Runtime Configuration
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Database Persistence
# ResQAI uses high-performance SQLite via better-sqlite3 with WAL mode enabled
DB_FILE_PATH=./server/data/resqai.db

# Authentication & Session Security (JWT)
# Generate cryptographically strong random secrets in production (e.g., openssl rand -hex 64)
JWT_SECRET=$JWT_SECRET
JWT_REFRESH_SECRET=$JWT_REFRESH_SECRET"
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Payment Gateway (Razorpay Test Mode / Production)
# Required for NGO relief donation processing and ledger audit reconciliation
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signature_secret_here

# Telephony, SMS & WhatsApp Intake Gateway (Mock Simulator fallback provided)
# Required for low-bandwidth cellular incident ingestion & emergency broadcast alerts
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here
SMS_GATEWAY_SENDER_ID=RESQAI
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# AI / ML Disaster Intelligence Services
# Used for early warning hydrological risk assessment, situation summaries & damage analysis
GEMINI_API_KEY=your_google_gemini_api_key_here
VERTEX_AI_PROJECT_ID=your_gcp_project_id_here
VERTEX_AI_LOCATION=us-central1


# Official Weather & External Disaster Telemetry Feeds
# Used for IMD (India Meteorological Dept) and GDACS early warning ingestion
IMD_API_KEY=your_imd_telemetry_access_key_here
GDACS_FEED_URL=https://www.gdacs.org/xml/rss.xml

# Client Frontend CORS & WebSocket Whitelist
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,https://resqai.web.app
