<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: Enforce HTTPS / system certs by default -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Domain configuration: Allow cleartext traffic only for local development backends -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android Emulator host loopback -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Standard localhost -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Common Private IPv4 subnets for physical device local LAN development -->
        <domain includeSubdomains="true">192.168.1.*</domain>
        <domain includeSubdomains="true">192.168.0.*</domain>
        <domain includeSubdomains="true">192.168.*.*</domain>
        <domain includeSubdomains="true">10.*.*.*</domain>
        <domain includeSubdomains="true">172.16.*.*</domain>
    </domain-config>
</network-security-config>

